# Application Configuration
APP_NAME="The Exam Timetable from Hell"
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=exam_timetable_super_secret_jwt_key_hell_edition_2026_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For local zero-dependency testing, defaults to sqlite:///./exam_timetable.db
# For PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/exam_timetable
